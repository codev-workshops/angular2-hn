{
  "name": "angular-hnpwa",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "lint": "ng lint",
    "e2e": "ng e2e",
    "test:e2e": "playwright test -c e2e/playwright/playwright.config.ts",
    "dev:react": "vite",
    "build:react": "vite build",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "lint:react": "eslint web scripts",
    "test:unit": "vitest run",
    "test:e2e:migrated": "node scripts/run-migrated-e2e.js",
    "format": "prettier --write web/src web/public/assets scripts vite.config.ts vitest.config.ts eslint.config.js PATTERN.md",
    "format:check": "prettier --check web/src web/public/assets scripts vite.config.ts vitest.config.ts eslint.config.js PATTERN.md"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~9.0.1",
    "@angular/common": "~9.0.1",
    "@angular/compiler": "~9.0.1",
    "@angular/core": "~9.0.1",
    "@angular/forms": "~9.0.1",
    "@angular/platform-browser": "~9.0.1",
    "@angular/platform-browser-dynamic": "~9.0.1",
    "@angular/router": "~9.0.1",
    "@angular/service-worker": "~9.0.1",
    "@vitejs/plugin-react": "4.6.0",
    "axios": "1.11.0",
    "dompurify": "3.2.6",
    "node-fetch": "^2.6.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router": "7.8.2",
    "rxjs": "~6.5.4",
    "rxjs-compat": "^6.5.2",
    "sass": "1.89.2",
    "tslib": "^1.10.0",
    "unfetch": "^4.1.0",
    "vite": "6.3.5",
    "zone.js": "~0.10.2",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~0.900.2",
    "@angular/cli": "~9.0.2",
    "@angular/compiler-cli": "~9.0.1",
    "@angular/language-service": "~9.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/jasmine": "~3.3.8",
    "@types/jasminewd2": "~2.0.3",
    "@types/node": "^12.11.1",
    "@types/react": "17.0.68",
    "@types/react-dom": "17.0.25",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "codelyzer": "^5.1.2",
    "eslint": "9.30.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "jasmine-core": "~3.4.0",
    "jasmine-spec-reporter": "~4.2.1",
    "jsdom": "26.1.0",
    "karma": "~4.1.0",
    "karma-chrome-launcher": "~2.2.0",
    "karma-coverage-istanbul-reporter": "~2.0.1",
    "karma-jasmine": "~2.0.1",
    "karma-jasmine-html-reporter": "^1.4.0",
    "prettier": "3.6.2",
    "protractor": "~5.4.0",
    "ts-node": "~7.0.0",
    "tslint": "~5.15.0",
    "typescript": "3.7.5",
    "vitest": "3.2.4"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 4,
    "singleQuote": true,
    "printWidth": 120
  }
}
