{
  "name": "angular-hnpwa",
  "version": "0.0.0",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "typecheck": "tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint web scripts",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e/playwright/playwright.config.ts",
    "format": "prettier --write web/src web/public/assets scripts vite.config.ts vitest.config.ts eslint.config.js MIGRATION-INVARIANTS.md README.md CONTRIBUTING.md",
    "format:check": "prettier --check web/src web/public/assets scripts vite.config.ts vitest.config.ts eslint.config.js MIGRATION-INVARIANTS.md README.md CONTRIBUTING.md"
  },
  "private": true,
  "dependencies": {
    "axios": "1.11.0",
    "dompurify": "3.2.6",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router": "7.8.2",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@typescript-eslint/eslint-plugin": "8.35.1",
    "@typescript-eslint/parser": "8.35.1",
    "@vitejs/plugin-react": "4.6.0",
    "eslint": "9.30.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "sass": "1.89.2",
    "typescript": "5.9.3",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "3.2.4"
  },
  "prettier": {
    "trailingComma": "es5",
    "tabWidth": 4,
    "singleQuote": true,
    "printWidth": 120
  }
}
